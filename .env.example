# Copy to .env and fill the ones you use. Never commit .env.
# config.yaml references these via $VAR syntax.

# LLM provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# 阿里云百炼(DashScope)—— code_index 的 embedding(text-embedding-v4)+ reranker(qwen3-rerank)。
# 用专属 MaaS 端点时,把 BASE_URL/RERANK_URL 填成你的 llm-xxxx.cn-*.maas.aliyuncs.com 端点;
# 用公共 serverless 则留空(代码回落 dashscope.aliyuncs.com 默认)。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_RERANK_URL=

# Web search (optional)
TAVILY_API_KEY=

# Observability (optional, self-hosted Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
