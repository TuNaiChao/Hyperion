# Copy to .env and fill the ones you use. Never commit .env.
# config.yaml references these via $VAR syntax.

# LLM provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Web search (optional)
TAVILY_API_KEY=

# Observability (optional, self-hosted Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
